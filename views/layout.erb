<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#fbf5ec" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#110c09" media="(prefers-color-scheme: dark)">
  <meta name="description" content="Dumpling Bros: an AI shopping agent that never spends a cent over your budget.">
  <title>Dumpling Bros · AI Shopping Agent</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="dough" cx="40%" cy="35%" r="75%">
        <stop offset="0" stop-color="#fffaf1"/><stop offset=".6" stop-color="#f8e2c0"/><stop offset="1" stop-color="#e9b77f"/>
      </radialGradient>
      <symbol id="dumpling" viewBox="0 0 64 64">
        <g class="steam" fill="none" stroke="#e8613a" stroke-width="3" stroke-linecap="round">
          <path d="M22 17c-3-3 3-6 0-10"/><path d="M32 16c-3-3 3-6 0-10"/><path d="M42 17c-3-3 3-6 0-10"/>
        </g>
        <path d="M7 41c0-11.5 11-20 25-20s25 8.5 25 20c0 6-5 10.5-11 10.5H18C12 51.5 7 47 7 41z" fill="url(#dough)" stroke="#7a3d17" stroke-width="2.4"/>
        <g fill="none" stroke="#c4844e" stroke-width="2" stroke-linecap="round">
          <path d="M17 28c2 3 2 6 1 9"/><path d="M25 24.5c1.2 3 1.2 7 0 10"/><path d="M33 23.5c0 3.5 0 7-1 10.5"/><path d="M41 24.5c-1 3-1 6.5-.5 9.5"/><path d="M48.5 28.5c-2 2.5-2.2 5.5-1.5 8"/>
        </g>
        <circle cx="25" cy="41.5" r="2.3" fill="#3a2214"/><circle cx="39" cy="41.5" r="2.3" fill="#3a2214"/>
        <path d="M29 45c1.7 1.7 4.3 1.7 6 0" fill="none" stroke="#3a2214" stroke-width="2" stroke-linecap="round"/>
        <circle cx="20" cy="45.5" r="2.6" fill="#ff7a5c" opacity=".55"/><circle cx="44" cy="45.5" r="2.6" fill="#ff7a5c" opacity=".55"/>
      </symbol>
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-card" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M2.5 10h19M6.5 15h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
      <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 10V7a3 3 0 0 1 6 0v3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
      <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3l2 5.5L19.5 10.5 14 12.5 12 18l-2-5.5L4.5 10.5 10 8.5z" fill="currentColor"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" fill="currentColor" opacity=".7"/></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
      <symbol id="i-snow" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v19M3.8 7.25l16.4 9.5M3.8 16.75l16.4-9.5"/><path d="M9.5 4l2.5 2 2.5-2M9.5 20l2.5-2 2.5 2"/></g></symbol>
      <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.5L22 20H2z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 10v4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="17.3" r="1.2" fill="currentColor"/></symbol>
      <symbol id="i-swap" viewBox="0 0 24 24"><path d="M7 4L3.5 7.5 7 11M3.5 7.5H17M17 13l3.5 3.5L17 20M20.5 16.5H7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
      <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
      <symbol id="i-dot" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" fill="currentColor"/></symbol>
      <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2.4"/><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
      <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2L4 14h7l-1 8 9-12h-7z" fill="currentColor"/></symbol>
      <symbol id="i-nfc" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 8.5a5 5 0 0 1 0 7"/><path d="M11.5 6a8.5 8.5 0 0 1 0 12"/><path d="M15 3.5a12 12 0 0 1 0 17"/></g></symbol>
    </defs>
  </svg>
  <a class="skip" href="#main">Skip to content</a>
  <% path = request.path_info %>
  <header class="topbar">
    <div class="wrap">
      <a href="/" class="brand" aria-label="Dumpling Bros home">
        <svg class="brand-mark" aria-hidden="true"><use href="#dumpling"/></svg>
        <span class="brand-text">Dumpling Bros <small>AI shopping agent</small></span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="/" <%= 'aria-current="page"' if path == "/" %>><svg aria-hidden="true"><use href="#i-plus"/></svg><span>New</span></a>
        <a href="/orders" <%= 'aria-current="page"' if path == "/orders" %>><svg aria-hidden="true"><use href="#i-bag"/></svg><span>Orders</span></a>
        <a href="/setup" <%= 'aria-current="page"' if path == "/setup" %>><svg aria-hidden="true"><use href="#i-card"/></svg><span>Card setup</span></a>
      </nav>
    </div>
  </header>
  <main id="main"><div class="wrap"><%= yield %></div></main>
  <footer class="site-foot">
    <div class="wrap">
      <span><span class="dot" aria-hidden="true"></span>Reap Cards + Agentic Payments · sandbox</span>
      <span>Dumpling Bros · one prepaid card per request, frozen after use</span>
    </div>
  </footer>
</body>
</html>
