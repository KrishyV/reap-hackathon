<%
  c = @current
  active = c[:active]
  pending = c[:status] == "REQUIRES_ACTION"
  step = active ? 3 : (pending ? 2 : 1)
  pf = @profile || {}
  check = '<svg aria-hidden="true"><use href="#i-check"/></svg>'
%>
<header class="page-head">
  <span class="eyebrow"><svg width="14" height="14" aria-hidden="true"><use href="#i-card"/></svg> One-time setup</span>
  <h1><%= active ? "Your card is connected" : "Connect the payment card" %></h1>
  <p>You add a card once on Reap's secure page. After that, every shopping request gets its own single-use prepaid card loaded with exactly your budget, and you never see this page again.</p>
</header>

<div class="setup-grid">
  <section class="glass panel stack" aria-labelledby="card-h" id="card-setup"
           data-status="<%= h c[:status] %>" data-expires="<%= h c[:expires_at] %>" data-id="<%= h c[:id] %>">
    <h2 class="section-title" id="card-h">Payment card
      <% if active %><span class="pill ok"><span class="led"></span>Active</span>
      <% elsif pending %><span class="pill warn live" id="live-pill"><span class="led"></span>Waiting for card</span>
      <% elsif c[:status] == "EXPIRED" %><span class="pill bad"><span class="led"></span>Link expired</span><% end %>
    </h2>
    <ol class="steps3">
      <li class="<%= step > 1 ? 'done' : 'active' %>"><i><%= step > 1 ? check : "1" %></i> Get a secure card link</li>
      <li class="<%= step > 2 ? 'done' : (step == 2 ? 'active' : '') %>"><i><%= step > 2 ? check : "2" %></i> Add the card and confirm with a passkey</li>
      <li class="<%= step == 3 ? 'done' : '' %>"><i><%= step == 3 ? check : "3" %></i> Done. This page updates by itself.</li>
    </ol>

    <% if @env_locked %>
      <p class="note"><svg aria-hidden="true"><use href="#i-shield"/></svg><span>Pinned by <code>REAP_ENROLLMENT_ID</code> in <code>.env</code>.</span></p>
    <% end %>

    <% if active %>
      <div class="vcard owned" aria-label="Connected card ending <%= h c[:last4] %>">
        <div class="vcard-top">
          <span class="vcard-brand"><svg aria-hidden="true"><use href="#dumpling"/></svg>Agent wallet</span>
          <span class="vcard-state"><span class="led"></span>Ready</span>
        </div>
        <div class="vcard-mid"><span class="vcard-chip"></span><svg class="vcard-nfc" aria-hidden="true"><use href="#i-nfc"/></svg></div>
        <div class="vcard-pan">•••• •••• •••• <%= h c[:last4] || "····" %></div>
        <div class="vcard-bottom">
          <div><small>Expires</small><b><%= h c[:expiry] || "--/--" %></b></div>
          <span class="vcard-net"><%= h (c[:network] || "VISA").to_s.upcase %></span>
        </div>
      </div>
      <div class="ready"><svg aria-hidden="true"><use href="#i-shield"/></svg><span>Ready. The agent can check out.</span>
        <a class="btn btn-sm" href="/">Start shopping <svg aria-hidden="true"><use href="#i-arrow"/></svg></a></div>

      <% if @saved.size > 1 %>
        <div class="saved stack" style="gap:8px">
          <h3 class="mini-title">Saved cards</h3>
          <% @saved.each do |s| %>
            <form method="post" action="/setup/use" class="saved-row">
              <input type="hidden" name="enrollment_id" value="<%= h s[:id] %>">
              <span class="saved-net"><%= h (s[:network] || "card").to_s.upcase %></span>
              <span>•••• <%= h s[:last4] %> <small class="muted">exp <%= h s[:expiry] %></small></span>
              <% if s[:id] == c[:id] %><span class="pill ok">In use</span><% else %><button class="btn btn-ghost btn-sm" <%= 'disabled' if @env_locked %>>Use</button><% end %>
            </form>
          <% end %>
        </div>
      <% end %>

    <% elsif pending %>
      <div class="handoff">
        <div class="handoff-main stack" style="gap:12px">
          <div class="banner safari-only" role="note" hidden>
            <svg aria-hidden="true"><use href="#i-alert"/></svg>
            <span><b>Mac Safari can't finish Visa's passkey step.</b> Copy the link into Chrome, Edge or Firefox to continue.</span>
          </div>
          <a class="btn btn-lg" id="open-card" data-hide-when-done target="_blank" rel="noopener" href="<%= h c[:url] %>">Add card on Reap <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
          <p class="note" id="popup-wait" hidden><svg aria-hidden="true"><use href="#i-card"/></svg><span>Finish in the Reap window. It closes and this page updates as soon as your card is added.</span></p>
          <p class="note" id="popup-done" role="status" hidden><svg aria-hidden="true"><use href="#i-shield"/></svg><span><b>Card set up on Reap.</b> Reap confirms it's ready to charge when this link's 15-minute window closes, <span id="confirm-eta">shortly</span>. Keep this page open; it switches to Ready by itself.</span></p>
          <p class="banner" id="popup-incomplete" role="alert" hidden><svg aria-hidden="true"><use href="#i-alert"/></svg><span><b>The card wasn't added.</b> Reap's window closed before the passkey step finished (Cancel or "Not now" also ends it). Click "Add card on Reap" to try again.</span></p>
          <div class="row-btns" data-hide-when-done>
            <button type="button" class="btn btn-ghost btn-sm" data-copy="<%= h c[:url] %>">Copy link</button>
            <span class="muted countdown" id="countdown"></span>
          </div>
        </div>
      </div>


      <p class="note"><svg aria-hidden="true"><use href="#i-shield"/></svg>
        <span><b>Why a passkey?</b> Visa needs a one-time Face ID, Touch ID or device PIN before an AI agent can be trusted with a card. Neither Reap nor this app can skip it. You only do it once, and it's saved on your device.</span></p>
    <% end %>


    <% unless active %>
      <form method="post" action="/setup/enroll" class="stack" style="gap:12px" data-hide-when-done>
        <% if pending %>
          <button type="submit" class="btn btn-ghost btn-sm">Get a fresh link</button>
          <input type="hidden" name="email" value="<%= h c[:email] || pf['email'] %>">
        <% else %>
          <label class="field">Email for the card owner
            <input name="email" type="email" required placeholder="you@gmail.com" autocomplete="email" value="<%= h pf['email'] %>">
          </label>
          <button type="submit" class="btn btn-lg"><%= c[:status] == "EXPIRED" ? "Get a fresh card link" : "Get a secure card link" %> <svg aria-hidden="true"><use href="#i-arrow"/></svg></button>
        <% end %>
      </form>
    <% end %>

    <details class="useid">
      <summary><%= active ? "Switch to another saved card" : "Already added a card before?" %></summary>
      <form method="post" action="/setup/use" class="stack" style="gap:10px">
        <p class="muted small">When you add a card, Reap stores it securely and gives this app an <b>enrollment ID</b>. The app never sees your card number. It only keeps that ID and quotes it at checkout. Because the card stays with Reap, you can reuse it by entering its ID here instead of adding it again.</p>
        <label class="field">Enrollment ID
          <input name="enrollment_id" required placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" pattern="[0-9a-fA-F-]{36}" autocomplete="off" spellcheck="false" <%= 'disabled' if @env_locked %>>
        </label>
        <button type="submit" class="btn btn-ghost btn-sm" <%= 'disabled' if @env_locked %>>Use this card</button>
        <% if active %><p class="muted small">This card's ID: <code><%= h c[:id] %></code> <button type="button" class="chip-copy" data-copy="<%= h c[:id] %>">copy</button></p><% end %>
      </form>
    </details>
  </section>

  <section class="glass panel stack" aria-labelledby="ship-h">
    <h2 class="section-title" id="ship-h">Default shipping
      <% if @profile %><span class="pill ok"><span class="led"></span>Saved</span><% end %>
    </h2>
    <p class="muted" style="font-size:15px">Saved details make checkout one tap and let <b>Autopilot</b> buy without review.</p>
    <form method="post" action="/profile" class="stack" style="gap:14px">
      <input type="hidden" name="return_to" value="/setup">
      <div class="fields">
        <label class="field">First name <input name="first_name" required autocomplete="given-name" value="<%= h pf['first_name'] %>"></label>
        <label class="field">Last name <input name="last_name" required autocomplete="family-name" value="<%= h pf['last_name'] %>"></label>
        <label class="field">Email <input name="email" type="email" required autocomplete="email" value="<%= h pf['email'] %>"></label>
        <label class="field">Phone <input name="phone" type="tel" required placeholder="+14155550123" autocomplete="tel" value="<%= h pf['phone'] %>"></label>
        <label class="field span-2">Address <input name="address_line1" required autocomplete="address-line1" value="<%= h pf['address_line1'] %>"></label>
        <label class="field">City <input name="city" required autocomplete="address-level2" value="<%= h pf['city'] %>"></label>
        <label class="field">State / region <input name="region" autocomplete="address-level1" value="<%= h pf['region'] %>"></label>
        <label class="field">Postal code <input name="postal_code" required autocomplete="postal-code" value="<%= h pf['postal_code'] %>"></label>
        <label class="field">Country <input name="country" required maxlength="2" pattern="[A-Za-z]{2}" placeholder="US" autocomplete="country" value="<%= h pf['country'] %>"></label>
      </div>
      <button type="submit" class="btn btn-ghost">Save shipping details</button>
    </form>
  </section>
</div>

<script src="/js/setup.js" defer></script>
<script src="/js/address-suggest.js" defer></script>
