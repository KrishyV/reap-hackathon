<div class="run" data-run="<%= h @run.id %>" data-enrolled="<%= @enrollment_id ? 'yes' : 'no' %>">
  <h1><%= h @run.goal %></h1>
  <p class="muted">Budget <b><%= h @run.budget %></b> · status <b id="status">…</b></p>

  <div class="grid">
    <div>
      <div id="review"></div>
      <div id="card"></div>
      <div id="orders"></div>
      <div id="receipt"></div>
    </div>
    <aside>
      <h3>Agent log</h3>
      <ol id="log" class="log"></ol>
    </aside>
  </div>
</div>

<template id="review-tpl">
  <form method="post" class="card" id="review-form">
    <h2>Proposed basket</h2>
    <div id="picks"></div>
    <div id="drops"></div>
    <p class="total">Estimated items total: <b id="est"></b> <span class="muted">(shipping &amp; tax added at quote; never exceeds your budget)</span></p>
    <h3>Ship to</h3>
    <div class="row">
      <label>First name <input name="first_name" required></label>
      <label>Last name <input name="last_name" required></label>
    </div>
    <div class="row">
      <label>Email <input name="email" type="email" required></label>
      <label>Phone <input name="phone" required placeholder="+14155550123"></label>
    </div>
    <label>Address <input name="address_line1" required></label>
    <div class="row">
      <label>City <input name="city" required></label>
      <label>State/region <input name="region"></label>
      <label>Postal code <input name="postal_code" required></label>
      <label>Country <input name="country" required value="US" maxlength="2"></label>
    </div>
    <button type="submit" id="buy">Issue prepaid card &amp; buy →</button>
    <p class="muted" id="enroll-warning" hidden>⚠️ Set up the payment card first on <a href="/setup">Payment setup</a>.</p>
  </form>
</template>

<script>
const root = document.querySelector(".run");
const id = root.dataset.run;
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
let reviewRendered = false;

function renderReview(run) {
  if (reviewRendered || run.status !== "awaiting_review" || !run.basket) return;
  reviewRendered = true;
  const node = document.getElementById("review-tpl").content.cloneNode(true);
  const form = node.querySelector("form");
  form.action = `/runs/${id}/purchase`;
  const picks = run.basket.picks.map(p => {
    const opts = [p.option, ...p.alternatives].map((o, i) => `
      <label class="opt"><input type="radio" name="option_${esc(p.key)}" value="${esc(o.product_id)}" ${i === 0 ? "checked" : ""}>
        ${o.image_url ? `<img src="${esc(o.image_url)}" alt="">` : ""}
        <span><b>${esc(o.name)}</b><br><small>${esc(o.merchant)} · ${esc(o.unit_price)}</small><br><small class="muted">${esc(o.reason || "")}</small></span>
      </label>`).join("");
    return `<fieldset class="pick"><legend><label><input type="checkbox" name="keep[]" value="${esc(p.key)}" checked>
      ${esc(p.need)} ×${p.quantity}</label> <span class="prio p${p.priority}">P${p.priority}</span></legend>
      <p class="muted">${esc(p.why)}</p>${opts}</fieldset>`;
  }).join("");
  node.getElementById("picks").innerHTML = picks;
  node.getElementById("drops").innerHTML = run.basket.drops.length
    ? `<p class="muted">Left out: ${run.basket.drops.map(d => `${esc(d.need)} (${esc(d.reason).replace(/_/g, " ")})`).join(", ")}</p>` : "";
  node.getElementById("est").textContent = `${run.basket.total} of ${run.budget}`;
  if (root.dataset.enrolled !== "yes") { node.getElementById("enroll-warning").hidden = false; }
  document.getElementById("review").replaceChildren(node);
}

function render(run) {
  document.getElementById("status").textContent = run.status.replace("_", " ");
  document.getElementById("log").innerHTML = run.log.map(l => `<li><time>${esc(l.at)}</time> ${esc(l.msg)}</li>`).join("");
  renderReview(run);
  if (run.status !== "awaiting_review") document.getElementById("review").innerHTML = "";
  if (run.card) {
    document.getElementById("card").innerHTML = `<div class="card vcard"><div>Prepaid virtual card</div>
      <div class="pan">•••• •••• •••• ${esc(run.card.last4)}</div><div>Loaded: ${esc(run.card.budget)} · single use${run.receipt?.frozen ? " · 🧊 frozen" : ""}</div>
      <button type="button" onclick="reveal()">Reveal card details</button><div id="reveal"></div></div>`;
  }
  document.getElementById("orders").innerHTML = run.orders.map(o => `<div class="card order ${esc(o.status.toLowerCase())}">
    <h3>${esc(o.merchant)} — ${esc(o.status.replace("_", " "))}</h3>
    <ul>${o.items.map(i => `<li>${esc(i.name)} ×${i.quantity} @ ${esc(i.unit_price)}</li>`).join("")}</ul>
    ${o.dropped.length ? `<p class="muted">Dropped to fit budget: ${o.dropped.map(esc).join(", ")}</p>` : ""}
    ${o.quoted_total ? `<p>Items ${esc(o.subtotal)} + shipping ${esc(o.shipping)} + tax ${esc(o.tax)} = <b>${esc(o.quoted_total)}</b></p>` : ""}
    ${o.approval_url && o.status === "AWAITING_APPROVAL" ? `<p><a class="button" target="_blank" rel="noopener" href="${esc(o.approval_url)}">Approve this charge →</a></p>` : ""}
    ${o.order_id ? `<p>Order <code>${esc(o.order_id)}</code> · charged <b>${esc(o.final_amount)}</b></p>` : ""}
    ${o.error ? `<p class="error">${esc(o.error)}</p>` : ""}</div>`).join("");
  if (run.receipt) {
    const r = run.receipt;
    document.getElementById("receipt").innerHTML = `<div class="card receipt"><h2>Receipt</h2>
      <p>${r.completed}/${r.orders} order(s) placed. Spent <b>${esc(r.spent)}</b> of ${esc(r.budget)} · unspent ${esc(r.unspent)} stays on the frozen card.</p>
      ${r.anomalies.length ? `<p class="error">${r.anomalies.map(esc).join("<br>")}</p>` : ""}</div>`;
  }
  if (run.error) document.getElementById("receipt").innerHTML = `<div class="card error">${esc(run.error)}</div>`;
  return !["done", "failed"].includes(run.status);
}

async function reveal() {
  const res = await fetch(`/runs/${id}/reveal`, { method: "POST" });
  if (!res.ok) return alert(await res.text());
  const { url } = await res.json();
  document.getElementById("reveal").innerHTML = `<iframe src="${esc(url)}" title="Card details"></iframe>`;
}

async function tick() {
  try {
    const res = await fetch(`/runs/${id}.json`);
    if (res.ok && !render(await res.json())) return;
  } catch (e) {}
  setTimeout(tick, 1500);
}
tick();
</script>
