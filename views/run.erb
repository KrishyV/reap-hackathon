<%
  flag = ->(cc) { cc.to_s.upcase.match?(/\A[A-Z]{2}\z/) ? cc.upcase.each_char.map { |c| (c.ord + 127_397).chr(Encoding::UTF_8) }.join : "🌐" }
  pf = @profile.is_a?(Hash) ? @profile : nil
  country = @run.ship_country.to_s
  autopilot = @run.respond_to?(:autopilot) && @run.autopilot
%>
<div class="run" data-run="<%= h @run.id %>" data-enrolled="<%= @enrollment_id ? 'yes' : 'no' %>" data-country="<%= h country %>" data-budget="<%= h @run.budget %>">
  <header class="run-head">
    <span class="eyebrow"><svg width="14" height="14" aria-hidden="true"><use href="#i-spark"/></svg> Shopping run</span>
    <h1>“<%= h @run.goal %>”</h1>
    <div class="run-meta">
      <span class="pill hot live" id="status-pill"><span class="led" aria-hidden="true"></span><span>Status: <b id="status">starting…</b></span></span>
      <span class="pill">Budget <b><%= h @run.budget %></b></span>
      <span class="pill"><span aria-hidden="true"><%= flag.(country) %></span> Ship to <%= h country %></span>
      <span class="pill ok" id="autopilot-pill" <%= 'hidden' unless autopilot %>><svg width="13" height="13" aria-hidden="true"><use href="#i-bolt"/></svg> Autopilot</span>
    </div>
    <div class="progress">
      <ol class="stepper" id="stepper" aria-label="Progress">
        <% %w[Plan Search Basket Card Checkout Done].each do |s| %>
          <li><span class="bar" aria-hidden="true"></span><span><%= s %></span></li>
        <% end %>
      </ol>
      <div class="now" id="now" role="status" aria-live="polite"><span class="orb" aria-hidden="true"></span><span class="now-text" id="now-text">Waking up the agent…</span></div>
    </div>
  </header>

  <div class="run-grid" id="grid">
    <div class="run-main" id="stage"></div>
    <aside class="run-side" id="side" aria-label="Summary and agent timeline">
      <div id="summary-slot"></div>
      <details class="glass timeline-card" id="timeline-card" open>
        <summary class="section-title">Agent timeline <span class="pill" id="log-count">0</span></summary>
        <ol class="timeline" id="log"></ol>
      </details>
    </aside>
  </div>
</div>

<template id="ship-tpl">
  <details class="glass ship" id="ship" <%= 'open' unless pf %>>
    <summary>
      <span class="ship-ico" aria-hidden="true"><svg><use href="#i-pin"/></svg></span>
      <span class="ship-text">
        <% if pf %>
          <b>Ship to <%= h [pf["first_name"], pf["last_name"]].compact.join(" ") %></b>
          <span><%= h [pf["address_line1"], pf["city"]].reject { |v| v.to_s.empty? }.join(", ") %> · <span aria-hidden="true"><%= flag.(country) %></span> <%= h country %></span>
        <% else %>
          <b>Where should it ship?</b>
          <span>Needed once. We'll remember it for next time.</span>
        <% end %>
      </span>
      <% if pf %><span class="ship-edit">edit</span><% end %>
    </summary>
    <div class="fields">
      <label class="field">First name <input name="first_name" required autocomplete="given-name" value="<%= h pf && pf['first_name'] %>"></label>
      <label class="field">Last name <input name="last_name" required autocomplete="family-name" value="<%= h pf && pf['last_name'] %>"></label>
      <label class="field">Email <input name="email" type="email" required autocomplete="email" value="<%= h pf && pf['email'] %>"></label>
      <label class="field">Phone <input name="phone" type="tel" required placeholder="+14155550123" autocomplete="tel" value="<%= h pf && pf['phone'] %>"></label>
      <label class="field span-2">Address <input name="address_line1" required autocomplete="address-line1" value="<%= h pf && pf['address_line1'] %>"></label>
      <label class="field">City <input name="city" required autocomplete="address-level2" value="<%= h pf && pf['city'] %>"></label>
      <label class="field">State / region <input name="region" autocomplete="address-level1" value="<%= h pf && pf['region'] %>"></label>
      <label class="field">Postal code <input name="postal_code" required autocomplete="postal-code" value="<%= h pf && pf['postal_code'] %>"></label>
      <label class="field">Country <input name="country" required maxlength="2" pattern="[A-Za-z]{2}" autocomplete="country"></label>
    </div>
  </details>
</template>

<script src="/js/run.js" defer></script>
<script src="/js/address-suggest.js" defer></script>
