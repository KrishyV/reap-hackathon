<header class="page-head">
  <span class="eyebrow"><svg width="14" height="14" aria-hidden="true"><use href="#i-bag"/></svg> History</span>
  <h1>Your orders</h1>
  <p>Every request got its own prepaid card, loaded with exactly the budget and frozen after checkout.</p>
</header>
<% if @history.nil? || @history.empty? %>
  <div class="glass empty">
    <svg aria-hidden="true"><use href="#dumpling"/></svg>
    <h2>No orders yet</h2>
    <p class="muted">Tell the agent what you need and it'll handle the rest.</p>
    <a class="btn" href="/">Start a request <svg aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>
<% else %>
  <%= erb :_history, locals: { history: @history } %>
<% end %>
